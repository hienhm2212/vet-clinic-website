---
import type { GetStaticPaths } from 'astro'
import ServiceDetail from '../../views/ServiceDetail.astro'
import { services } from '../../data/services'

export const getStaticPaths = (() =>
  services.map(service => ({ params: { slug: service.slug.vi }, props: { service } }))) satisfies GetStaticPaths

const { service } = Astro.props
---

<ServiceDetail lang="vi" service={service} />
