---
import { clinic } from '../data/clinic'
import { tr, ui, type Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
---

<p
  class="open-status"
  data-open-status
  data-open={clinic.hours.open}
  data-close={clinic.hours.close}
  data-open-label={tr(ui.openNow, lang)}
  data-closed-label={tr(ui.closedNow, lang)}
  data-closes-at={tr(ui.closesAt, lang)}
  data-opens-at={tr(ui.opensAt, lang)}
>
  <span class="dot" aria-hidden="true"></span>
  <span data-open-label>
    {lang === 'vi' ? 'Mở cửa' : 'Open'}
    {clinic.hours.open} – {clinic.hours.close} {lang === 'vi' ? 'mỗi ngày' : 'every day'}
  </span>
</p>

<style>
  .open-status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line);
    font-weight: 700;
    font-size: 0.92rem;
    box-shadow: var(--shadow-sm);
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .open-status[data-state='closed'] .dot {
    background: #b45309;
    box-shadow: 0 0 0 4px #fde68a;
  }

  @media (prefers-reduced-motion: no-preference) {
    .open-status[data-state='open'] .dot {
      animation: pulse 2s ease-in-out infinite;
    }
  }

  @keyframes pulse {
    50% {
      box-shadow: 0 0 0 7px rgb(15 118 110 / 12%);
    }
  }
</style>
