---
import { halloween } from '../../data/season'
---

<!-- Runs before first paint so seasonal decorations never cause a layout shift. -->
<script is:inline define:vars={{ start: halloween.start, end: halloween.end, key: halloween.storageKey }}>
  try {
    var root = document.documentElement
    var q = new URLSearchParams(location.search).get('season')
    var md = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Ho_Chi_Minh', month: '2-digit', day: '2-digit' }).format(new Date())
    if (q ? q === 'halloween' : md >= start && md <= end) {
      root.dataset.season = 'halloween'
      if (localStorage.getItem(key)) root.dataset.seasonBanner = 'hidden'
    }
  } catch (e) {}
</script>
