---
import Bat from './Bat.astro'
import Ghost from './Ghost.astro'
import Pumpkin from './Pumpkin.astro'
import Spider from './Spider.astro'
---

<!-- Decorative only; hidden outside the Halloween window by the global `.seasonal` rule. -->
<div class="decor decor--halloween seasonal seasonal--halloween" aria-hidden="true">
  <div class="flight flight-1"><Bat size={70} beat={0.4} /></div>
  <div class="flight flight-2"><Bat size={46} beat={0.32} /></div>
  <div class="flight flight-3"><Bat size={36} beat={0.36} /></div>
  <Spider class="spin" drop={120} />
  <Ghost class="boo" size={64} />
  <div class="patch">
    <Pumpkin class="pk-big" size={92} />
    <Pumpkin class="pk-small" size={58} delay={1.3} />
  </div>
</div>

<style>
  .decor {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .flight {
    position: absolute;
  }

  .flight-1 {
    top: -2%;
    left: 4%;
  }

  .flight-2 {
    top: -4%;
    left: 46%;
  }

  .flight-3 {
    top: 10%;
    right: 0;
  }

  .decor :global(.spin) {
    right: 3%;
  }

  .decor :global(.boo) {
    position: absolute;
    top: 36%;
    left: 0;
    filter: drop-shadow(0 10px 14px rgb(46 16 101 / 22%));
  }

  .patch {
    position: absolute;
    right: 2%;
    bottom: -3%;
    display: flex;
    align-items: flex-end;
    flex-direction: row-reverse;
  }

  .patch :global(.pk-small) {
    margin-right: -14px;
    margin-bottom: 2px;
  }

  /* Flight paths: soft arcs with banking, each bat on its own rhythm. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-season]) .flight-1 {
      animation: fly-a 9s ease-in-out infinite;
    }

    :global(html[data-season]) .flight-2 {
      animation: fly-b 7s ease-in-out -3s infinite;
    }

    :global(html[data-season]) .flight-3 {
      animation: fly-c 8s ease-in-out -5s infinite;
    }
  }

  @keyframes fly-a {
    0%,
    100% {
      transform: translate(0, 0) rotate(-4deg);
    }

    25% {
      transform: translate(26px, -14px) rotate(6deg);
    }

    50% {
      transform: translate(48px, 4px) rotate(-2deg);
    }

    75% {
      transform: translate(18px, 14px) rotate(-8deg);
    }
  }

  @keyframes fly-b {
    0%,
    100% {
      transform: translate(0, 0) rotate(4deg);
    }

    33% {
      transform: translate(-22px, 10px) rotate(-6deg);
    }

    66% {
      transform: translate(16px, -8px) rotate(8deg);
    }
  }

  @keyframes fly-c {
    0%,
    100% {
      transform: translate(0, 0) rotate(-6deg);
    }

    50% {
      transform: translate(-30px, 18px) rotate(6deg);
    }
  }

  @media (max-width: 760px) {
    /* The doctor badge sits at the bottom on phones: keep the pumpkins off it. */
    .patch {
      top: 38%;
      right: -3%;
      bottom: auto;
    }

    .patch :global(.pk-big) {
      width: 66px;
      height: 59px;
    }

    .patch :global(.pk-small) {
      display: none;
    }

    .decor :global(.boo) {
      width: 50px;
      height: 65px;
    }

    .flight-3 {
      display: none;
    }
  }
</style>
