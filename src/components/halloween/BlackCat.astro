---
/* A sitting black cat with glowing eyes, a swishing tail and an orange collar. */
interface Props {
  class?: string
  size?: number
}
const { class: className, size = 96 } = Astro.props
const id = `cat-${crypto.randomUUID().slice(0, 6)}`
---

<svg class:list={['cat', className]} width={size} height={size} viewBox="0 0 96 96" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`${id}-fur`} x1="0.2" y1="0" x2="0.8" y2="1">
      <stop offset="0" stop-color="#4c3a73"></stop>
      <stop offset="1" stop-color="#110a20"></stop>
    </linearGradient>
    <radialGradient id={`${id}-eye`} cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#fef08a"></stop>
      <stop offset="1" stop-color="#a3e635"></stop>
    </radialGradient>
  </defs>
  <g class="tail">
    <path d="M62 84c14 0 22-8 22-20 0-8-4-14-9-17" stroke={`url(#${id}-fur)`} stroke-width="7" fill="none" stroke-linecap="round"></path>
  </g>
  <path d="M30 92c-6 0-9-4-8-12 1-14 6-28 14-34h24c8 6 13 20 14 34 1 8-2 12-8 12z" fill={`url(#${id}-fur)`}></path>
  <ellipse cx="40" cy="91" rx="6" ry="3.5" fill="#1e1035"></ellipse>
  <ellipse cx="56" cy="91" rx="6" ry="3.5" fill="#1e1035"></ellipse>
  <g class="head">
    <path d="M26 16l4 18h-6zM70 16l-4 18h6z" fill={`url(#${id}-fur)`}></path>
    <path d="M27.5 21l2 10h-3.5zM68.5 21l-2 10h3.5z" fill="#f9a8d4" opacity="0.75"></path>
    <ellipse cx="48" cy="34" rx="23" ry="19" fill={`url(#${id}-fur)`}></ellipse>
    <ellipse cx="38" cy="25" rx="6" ry="3" fill="#fff" opacity="0.08" transform="rotate(-20 38 25)"></ellipse>
    <g class="eyes">
      <ellipse cx="39" cy="33" rx="5.5" ry="6" fill={`url(#${id}-eye)`}></ellipse>
      <ellipse cx="57" cy="33" rx="5.5" ry="6" fill={`url(#${id}-eye)`}></ellipse>
      <ellipse cx="39" cy="33" rx="1.6" ry="4.6" fill="#1e1035"></ellipse>
      <ellipse cx="57" cy="33" rx="1.6" ry="4.6" fill="#1e1035"></ellipse>
      <circle cx="40.6" cy="31" r="1.3" fill="#fff"></circle>
      <circle cx="58.6" cy="31" r="1.3" fill="#fff"></circle>
    </g>
    <path d="M46.3 40.5h3.4L48 42.5z" fill="#f9a8d4"></path>
    <path d="M44 44q4 3 4-1.5 0 4.5 4 1.5" stroke="#6b5b8a" stroke-width="1" fill="none" stroke-linecap="round"></path>
    <path d="M34 41l-9-1M34 43.5l-9 2M62 41l9-1M62 43.5l9 2" stroke="#6b5b8a" stroke-width="0.8" stroke-linecap="round"></path>
  </g>
  <path d="M33 50q15 7 30 0" stroke="#f97316" stroke-width="4" fill="none" stroke-linecap="round"></path>
  <circle cx="48" cy="55.5" r="3.2" fill="#fde047"></circle>
  <circle cx="47" cy="54.5" r="1" fill="#fff" opacity="0.8"></circle>
</svg>

<style>
  .tail,
  .head,
  .eyes {
    transform-box: fill-box;
  }

  .tail {
    transform-origin: 0% 100%;
  }

  .head {
    transform-origin: 50% 90%;
  }

  .eyes {
    transform-origin: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-season]) .tail {
      animation: swish 3.6s ease-in-out infinite;
    }

    :global(html[data-season]) .head {
      animation: tilt 9s ease-in-out infinite;
    }

    :global(html[data-season]) .eyes {
      animation: blink 6s steps(1, end) 2s infinite;
    }
  }

  @keyframes swish {
    0%,
    100% {
      transform: rotate(0);
    }

    30% {
      transform: rotate(-14deg);
    }

    60% {
      transform: rotate(6deg);
    }
  }

  @keyframes tilt {
    0%,
    40%,
    100% {
      transform: rotate(0);
    }

    50%,
    70% {
      transform: rotate(-8deg);
    }
  }

  @keyframes blink {
    0%,
    94% {
      transform: none;
    }

    95% {
      transform: scaleY(0.1);
    }

    98% {
      transform: none;
    }
  }
</style>
