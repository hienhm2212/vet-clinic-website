---
import { clinic } from '../../data/clinic'
import { halloween } from '../../data/season'
import type { Lang } from '../../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const vi = lang === 'vi'
---

<aside class="season-banner seasonal" aria-label="Halloween" data-season-key={halloween.storageKey}>
  <p>
    <span aria-hidden="true">🎃</span>{' '}
    <strong>{vi ? 'Halloween vui vẻ!' : 'Happy Halloween!'}</strong>{' '}
    {vi ? 'Socola và kẹo không đường rất độc với chó mèo — nếu bé lỡ ăn, ' : 'Chocolate and sugar-free candy are toxic to pets — if yours ate some, '}
    {' '}<a href={clinic.phoneHref}>{vi ? 'gọi ngay' : 'call'} {clinic.phone}</a>.
  </p>
  <button type="button" data-season-dismiss aria-label={vi ? 'Đóng thông báo Halloween' : 'Close Halloween notice'}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
  </button>
</aside>

<script>
  document.querySelectorAll<HTMLElement>('.season-banner').forEach(banner => {
    banner.querySelector('[data-season-dismiss]')?.addEventListener('click', () => {
      document.documentElement.dataset.seasonBanner = 'hidden'
      try {
        localStorage.setItem(banner.dataset.seasonKey!, '1')
      } catch {
        /* storage blocked: the banner stays closed for this page view only */
      }
    })
  })
</script>

<style>
  .season-banner {
    position: relative;
    z-index: 51;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 10px 56px 10px var(--gutter);
    background:
      radial-gradient(circle at 8% 50%, rgb(249 115 22 / 35%), transparent 30%),
      linear-gradient(90deg, #2e1065, #4c1d95 50%, #2e1065);
    color: #f5f3ff;
    font-size: 0.95rem;
    text-align: center;
  }

  :global(html[data-season-banner='hidden']) .season-banner {
    display: none;
  }

  p {
    max-width: 960px;
  }

  strong {
    color: #fdba74;
  }

  a {
    color: #fff;
    font-weight: 700;
  }

  a:hover {
    color: #fdba74;
  }

  button {
    position: absolute;
    right: 8px;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #f5f3ff;
    cursor: pointer;
  }

  button:hover {
    background: rgb(255 255 255 / 12%);
  }
</style>
