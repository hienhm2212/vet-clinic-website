---
import SeasonBanner from '../season/SeasonBanner.astro'
import Pumpkin from './Pumpkin.astro'
import { clinic } from '../../data/clinic'
import { halloween } from '../../data/season'
import type { Lang } from '../../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const vi = lang === 'vi'
---

<SeasonBanner season={halloween} label="Halloween" closeLabel={vi ? 'Đóng thông báo Halloween' : 'Close Halloween notice'}>
  <Pumpkin class="banner-icon" size={26} />
  <strong>{vi ? 'Halloween vui vẻ!' : 'Happy Halloween!'}</strong>{' '}
  {vi ? 'Socola và kẹo không đường rất độc với chó mèo — nếu bé lỡ ăn, ' : 'Chocolate and sugar-free candy are toxic to pets — if yours ate some, '}
  {' '}<a href={clinic.phoneHref}>{vi ? 'gọi ngay' : 'call'} {clinic.phone}</a>.
</SeasonBanner>
