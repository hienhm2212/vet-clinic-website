---
/* Jack-o'-lantern with shaded lobes and a candle glow that flickers. */
interface Props {
  class?: string
  size?: number
  /** Delay (s) so several pumpkins don't flicker together. */
  delay?: number
}
const { class: className, size = 80, delay = 0 } = Astro.props
const id = `pk-${crypto.randomUUID().slice(0, 6)}`
---

<svg class:list={['pumpkin', className]} style={`--delay:${-delay}s`} width={size} height={size * 0.9} viewBox="0 0 80 72" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`${id}-side`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#fb923c"></stop>
      <stop offset="1" stop-color="#c2410c"></stop>
    </linearGradient>
    <linearGradient id={`${id}-mid`} x1="0" y1="0" x2="0.6" y2="1">
      <stop offset="0" stop-color="#fdba74"></stop>
      <stop offset="0.5" stop-color="#f97316"></stop>
      <stop offset="1" stop-color="#ea580c"></stop>
    </linearGradient>
    <radialGradient id={`${id}-glow`} cx="0.5" cy="0.45" r="0.6">
      <stop offset="0" stop-color="#fffbeb"></stop>
      <stop offset="0.55" stop-color="#fde047"></stop>
      <stop offset="1" stop-color="#f59e0b"></stop>
    </radialGradient>
    <linearGradient id={`${id}-stem`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#84cc16"></stop>
      <stop offset="1" stop-color="#3f6212"></stop>
    </linearGradient>
  </defs>
  <ellipse cx="40" cy="68" rx="28" ry="3.5" fill="#431407" opacity="0.18"></ellipse>
  <g class="stem">
    <path d="M38 18c-1-6 1-11 6-14l3 2c-4 3-5 7-4 12z" fill={`url(#${id}-stem)`}></path>
    <path d="M45 8c6-4 12-2 14 3-5 2-10 1-14-3z" fill="#65a30d"></path>
    <path d="M46.5 8.5c4-1 7 0 9.5 2" stroke="#3f6212" stroke-width="0.8" fill="none" stroke-linecap="round"></path>
    <path d="M37 15c-4-2-8 0-8 3s3 4 5 2" stroke="#4d7c0f" stroke-width="1.6" fill="none" stroke-linecap="round"></path>
  </g>
  <ellipse cx="20" cy="42" rx="16" ry="23" fill={`url(#${id}-side)`}></ellipse>
  <ellipse cx="60" cy="42" rx="16" ry="23" fill={`url(#${id}-side)`}></ellipse>
  <ellipse cx="30" cy="42" rx="14" ry="24.5" fill={`url(#${id}-mid)`}></ellipse>
  <ellipse cx="50" cy="42" rx="14" ry="24.5" fill={`url(#${id}-mid)`}></ellipse>
  <ellipse cx="40" cy="42" rx="12" ry="25" fill={`url(#${id}-mid)`}></ellipse>
  <path d="M30 19c-3 8-3 38 0 46M50 19c3 8 3 38 0 46" stroke="#c2410c" stroke-width="1.1" fill="none" opacity="0.55"></path>
  <ellipse cx="31" cy="27" rx="4" ry="7" fill="#fff" opacity="0.28" transform="rotate(-18 31 27)"></ellipse>
  <g class="face" fill={`url(#${id}-glow)`}>
    <path d="M24 37q4-8 9-1-4 3-9 1zM47 36q5-7 9 1-5 2-9-1z"></path>
    <path d="M38.2 41.5h3.6l-1.8 3z"></path>
    <path d="M23 47q17 13 34 0-2 7-8 9l-1-3-3 3-5-1-5 1-3-3-1 3q-6-2-8-9z"></path>
  </g>
</svg>

<style>
  .face {
    filter: drop-shadow(0 0 2px #fde047);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-season]) .face {
      animation: flicker 3.2s linear var(--delay) infinite;
    }
  }

  @keyframes flicker {
    0%,
    100% {
      opacity: 1;
    }

    8% {
      opacity: 0.78;
    }

    12% {
      opacity: 0.95;
    }

    40% {
      opacity: 0.85;
    }

    44% {
      opacity: 1;
    }

    71% {
      opacity: 0.7;
    }

    74% {
      opacity: 0.92;
    }
  }
</style>
