---
import Bat from './Bat.astro'
import Pumpkin from './Pumpkin.astro'
import BlackCat from './BlackCat.astro'
import { clinic } from '../../data/clinic'
import { halloweenTips } from '../../data/season'
import { tr, type Lang } from '../../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const vi = lang === 'vi'
---

<section class="tips seasonal seasonal--halloween" aria-labelledby="halloween-title">
  <div class="sky" aria-hidden="true">
    {Array.from({ length: 9 }, (_, i) => <span class={`star star-${i}`} />)}
    <div class="moon">
      <span class="halo"></span>
      <svg viewBox="0 0 100 100" width="100%" height="100%">
        <defs>
          <radialGradient id="moon-face" cx="0.35" cy="0.3" r="0.75">
            <stop offset="0" stop-color="#fffbeb"></stop>
            <stop offset="0.6" stop-color="#fde68a"></stop>
            <stop offset="1" stop-color="#f59e0b"></stop>
          </radialGradient>
        </defs>
        <circle cx="50" cy="50" r="48" fill="url(#moon-face)"></circle>
        <circle cx="64" cy="34" r="8" fill="#f59e0b" opacity="0.25"></circle>
        <circle cx="38" cy="62" r="11" fill="#f59e0b" opacity="0.2"></circle>
        <circle cx="68" cy="66" r="5" fill="#f59e0b" opacity="0.25"></circle>
        <circle cx="30" cy="34" r="4" fill="#f59e0b" opacity="0.2"></circle>
      </svg>
    </div>
    <div class="sky-flight sky-flight-1"><Bat size={52} beat={0.38} /></div>
    <div class="sky-flight sky-flight-2"><Bat size={34} beat={0.3} /></div>
  </div>
  <div class="container inner">
    <div class="head">
      <span class="tag"><span aria-hidden="true">🎃</span> Halloween</span>
      <h2 id="halloween-title">{vi ? 'Halloween an toàn cho bé' : 'A safe Halloween for your pet'}</h2>
      <p>
        {
          vi
            ? 'Mùa lễ hội cũng là lúc phòng khám gặp nhiều ca ngộ độc và hoảng sợ ở chó mèo nhất. Vài lưu ý nhỏ để cả nhà cùng vui:'
            : 'Holidays bring more poisonings and frightened pets than any other time. A few tips so the whole family can enjoy it:'
        }
      </p>
    </div>
    <ul class="grid">
      {
        halloweenTips.map(t => (
          <li class="tip">
            <span class="emoji" aria-hidden="true">
              {t.icon}
            </span>
            <h3>{tr(t.title, lang)}</h3>
            <p>{tr(t.text, lang)}</p>
          </li>
        ))
      }
    </ul>
    <div class="alert">
      <BlackCat class="perch" size={92} />
      <Pumpkin size={60} />
      <p>
        <strong>{vi ? 'Bé lỡ ăn socola hoặc kẹo?' : 'Did your pet eat chocolate or candy?'}</strong>
        {vi ? ' Đừng chờ triệu chứng — gọi bác sĩ ngay để được hướng dẫn xử lý.' : ' Don’t wait for symptoms — call the vet right away for advice.'}
      </p>
      <a class="btn btn--primary" href={clinic.phoneHref}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        {clinic.phone}
      </a>
    </div>
  </div>
</section>

<style>
  .tips {
    position: relative;
    margin-top: clamp(40px, 6vw, 72px);
    padding-block: clamp(56px, 8vw, 96px);
    background:
      radial-gradient(circle at 85% 12%, rgb(167 139 250 / 25%), transparent 35%),
      radial-gradient(circle at 10% 100%, rgb(249 115 22 / 22%), transparent 40%),
      linear-gradient(180deg, #1e1035, #2e1065);
    color: #ede9fe;
    overflow: hidden;
  }

  .sky {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(1.5px 1.5px at 12% 20%, rgb(255 255 255 / 70%) 50%, transparent 51%),
      radial-gradient(1px 1px at 30% 70%, rgb(255 255 255 / 70%) 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 55% 15%, rgb(255 255 255 / 70%) 50%, transparent 51%),
      radial-gradient(1px 1px at 70% 55%, rgb(255 255 255 / 70%) 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 92% 80%, rgb(255 255 255 / 70%) 50%, transparent 51%),
      radial-gradient(1px 1px at 40% 40%, rgb(255 255 255 / 70%) 50%, transparent 51%);
  }

  .star {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 6px 1px rgb(255 255 255 / 60%);
    opacity: 0.8;
  }

  .star-0 { top: 14%; left: 8%; }
  .star-1 { top: 30%; left: 22%; }
  .star-2 { top: 8%; left: 40%; }
  .star-3 { top: 22%; left: 58%; }
  .star-4 { top: 60%; left: 4%; }
  .star-5 { top: 78%; left: 30%; }
  .star-6 { top: 44%; left: 72%; }
  .star-7 { top: 86%; left: 92%; }
  .star-8 { top: 6%; left: 70%; }

  .moon {
    position: absolute;
    top: 32px;
    right: 8%;
    width: 96px;
    height: 96px;
  }

  .halo {
    position: absolute;
    inset: -40%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(253 230 138 / 35%), transparent 65%);
  }

  .moon svg {
    position: relative;
  }

  .sky-flight {
    position: absolute;
  }

  .sky-flight-1 {
    top: 64px;
    right: calc(8% + 70px);
  }

  .sky-flight-2 {
    top: 24px;
    right: calc(8% + 130px);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-season]) .star {
      animation: twinkle 3s ease-in-out infinite;
    }

    .star-1, .star-4, .star-7 { animation-delay: -1s !important; animation-duration: 4s !important; }
    .star-2, .star-5, .star-8 { animation-delay: -2.2s !important; animation-duration: 2.4s !important; }

    :global(html[data-season]) .halo {
      animation: glow 5s ease-in-out infinite;
    }

    :global(html[data-season]) .sky-flight-1 {
      animation: cross 14s ease-in-out infinite;
    }

    :global(html[data-season]) .sky-flight-2 {
      animation: cross 11s ease-in-out -6s infinite reverse;
    }
  }

  @keyframes twinkle {
    0%, 100% { opacity: 0.85; transform: scale(1); }
    50% { opacity: 0.2; transform: scale(0.6); }
  }

  @keyframes glow {
    0%, 100% { opacity: 0.7; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.08); }
  }

  @keyframes cross {
    0%, 100% { transform: translate(0, 0) rotate(-6deg); }
    30% { transform: translate(-60px, 20px) rotate(4deg); }
    60% { transform: translate(-20px, 40px) rotate(-4deg); }
  }

  .inner {
    position: relative;
  }

  .head {
    max-width: 680px;
  }

  .tag {
    display: inline-flex;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgb(249 115 22 / 18%);
    color: #fdba74;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    margin-top: 12px;
    color: #fff;
  }

  .head p {
    margin-top: 12px;
    color: #ddd6fe;
    font-size: 1.08rem;
  }

  .grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: 36px;
  }

  .tip {
    padding: 24px;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 7%);
    border: 1px solid rgb(255 255 255 / 12%);
    backdrop-filter: blur(4px);
  }

  .emoji {
    font-size: 2rem;
    line-height: 1;
  }

  .tip h3 {
    margin-block: 12px 6px;
    color: #fff;
    font-size: 1.15rem;
  }

  .tip p {
    color: #ddd6fe;
    font-size: 0.97rem;
  }

  .alert {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 20px;
    /* Room for the black cat perched on the top edge. */
    margin-top: 92px;
    padding: 18px 24px;
    border-radius: var(--radius);
    background: #fff7ed;
    color: var(--ink);
  }

  .alert p {
    flex: 1 1 280px;
  }

  /* The cat sits on the card's top edge, next to the call button. */
  .alert :global(.perch) {
    position: absolute;
    right: 210px;
    bottom: calc(100% - 14px);
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .moon {
      width: 60px;
      height: 60px;
      top: 20px;
    }

    .alert :global(.perch) {
      right: 12px;
      width: 72px;
      height: 72px;
    }
  }
</style>
