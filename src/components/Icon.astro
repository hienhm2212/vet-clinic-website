  paw: '<circle cx="5.5" cy="10" r="2.2"/><circle cx="9.5" cy="5.5" r="2.2"/><circle cx="14.5" cy="5.5" r="2.2"/><circle cx="18.5" cy="10" r="2.2"/><path d="M12 11c-3 0-6.5 4.2-6.5 6.8C5.5 20 7.3 21 9 21c1.3 0 2-.6 3-.6s1.7.6 3 .6c1.7 0 3.5-1 3.5-3.2C18.5 15.2 15 11 12 11Z"/>',
}

const FILLED = new Set(['star', 'paw'])

export type IconName = keyof typeof ICONS

interface Props {
  name: IconName
  size?: number
  class?: string
  label?: string
}

const { name, size = 24, class: className, label } = Astro.props
const filled = FILLED.has(name)
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={ICONS[name]}
/>
