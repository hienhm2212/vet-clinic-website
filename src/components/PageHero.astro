---
import Breadcrumbs from './Breadcrumbs.astro'
import type { Lang } from '../i18n'

interface Props {
  lang: Lang
  title: string
  lead: string
  crumbs: { name: string; path: string }[]
}
const { lang, title, lead, crumbs } = Astro.props
---

<section class="page-hero">
  <div class="container">
    <Breadcrumbs items={crumbs} lang={lang} />
    <h1>{title}</h1>
    <p class="lead">{lead}</p>
    <slot />
  </div>
</section>

<style>
  .page-hero {
    padding-block: clamp(40px, 6vw, 72px) clamp(40px, 6vw, 64px);
    background:
      radial-gradient(circle at 90% 10%, rgb(255 237 213 / 90%), transparent 45%),
      radial-gradient(circle at 0% 100%, rgb(213 245 239 / 80%), transparent 40%),
      var(--bg);
    border-bottom: 1px solid var(--line);
  }

  h1 {
    margin-top: 18px;
    max-width: 20ch;
  }

  .lead {
    margin-top: 16px;
    max-width: 62ch;
    font-size: 1.15rem;
    color: var(--ink-2);
  }
</style>
