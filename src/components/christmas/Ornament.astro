---
/* A glass bauble hanging from a ribbon, swinging gently from the top. */
interface Props {
  class?: string
  size?: number
  /** Thread length in px. */
  drop?: number
  hue?: 'red' | 'gold' | 'teal'
  delay?: number
}
const { class: className, size = 44, drop = 70, hue = 'red', delay = 0 } = Astro.props
const id = `orn-${crypto.randomUUID().slice(0, 6)}`
const colors = {
  red: ['#f87171', '#b91c1c', '#7f1d1d'],
  gold: ['#fde68a', '#f59e0b', '#b45309'],
  teal: ['#5eead4', '#0f766e', '#134e4a'],
}[hue]
---

<div class:list={['ornament', className]} style={`--drop:${drop}px;--delay:${-delay}s`} aria-hidden="true">
  <span class="ribbon"></span>
  <svg width={size} height={size * 1.15} viewBox="0 0 40 46" focusable="false">
    <defs>
      <radialGradient id={`${id}-g`} cx="0.35" cy="0.35" r="0.75">
        <stop offset="0" stop-color={colors[0]}></stop>
        <stop offset="0.6" stop-color={colors[1]}></stop>
        <stop offset="1" stop-color={colors[2]}></stop>
      </radialGradient>
      <linearGradient id={`${id}-cap`} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#fef3c7"></stop>
        <stop offset="0.5" stop-color="#fbbf24"></stop>
        <stop offset="1" stop-color="#b45309"></stop>
      </linearGradient>
    </defs>
    <circle cx="20" cy="4" r="3" fill="none" stroke="#b45309" stroke-width="1.4"></circle>
    <rect x="15" y="6" width="10" height="6" rx="1.5" fill={`url(#${id}-cap)`}></rect>
    <circle cx="20" cy="28" r="17" fill={`url(#${id}-g)`}></circle>
    <path d="M4.5 25q15.5 7 31 0M3.5 31q16.5 7 33 0" stroke="#fff" stroke-width="1.6" fill="none" opacity="0.35"></path>
    <circle cx="20" cy="28" r="2" fill="#fde68a" opacity="0.8"></circle>
    <circle cx="11" cy="28" r="1.4" fill="#fde68a" opacity="0.8"></circle>
    <circle cx="29" cy="28" r="1.4" fill="#fde68a" opacity="0.8"></circle>
    <ellipse cx="13" cy="20" rx="3.5" ry="5.5" fill="#fff" opacity="0.45" transform="rotate(30 13 20)"></ellipse>
  </svg>
</div>

<style>
  .ornament {
    position: absolute;
    top: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform-origin: top center;
  }

  .ribbon {
    width: 2px;
    height: var(--drop);
    background: linear-gradient(#b91c1c, #ef4444);
    margin-bottom: -3px;
  }

  svg {
    filter: drop-shadow(0 6px 8px rgb(127 29 29 / 25%));
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-season]) .ornament {
      animation: swing 4.2s ease-in-out var(--delay) infinite;
    }
  }

  @keyframes swing {
    0%,
    100% {
      transform: rotate(5deg);
    }

    50% {
      transform: rotate(-5deg);
    }
  }
</style>
