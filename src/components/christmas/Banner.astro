---
import SeasonBanner from '../season/SeasonBanner.astro'
import { clinic } from '../../data/clinic'
import { christmas } from '../../data/season'
import type { Lang } from '../../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const vi = lang === 'vi'
---

<SeasonBanner season={christmas} label={vi ? 'Giáng sinh' : 'Christmas'} closeLabel={vi ? 'Đóng thông báo Giáng sinh' : 'Close Christmas notice'}>
  <svg class="banner-icon" width="22" height="24" viewBox="0 0 40 46" aria-hidden="true" focusable="false">
    <circle cx="20" cy="4" r="3" fill="none" stroke="#fbbf24" stroke-width="1.6"></circle>
    <rect x="15" y="6" width="10" height="6" rx="1.5" fill="#fbbf24"></rect>
    <circle cx="20" cy="28" r="17" fill="#fde68a"></circle>
    <path d="M4.5 25q15.5 7 31 0M3.5 31q16.5 7 33 0" stroke="#b91c1c" stroke-width="2" fill="none"></path>
    <ellipse cx="13" cy="20" rx="3.5" ry="5.5" fill="#fff" opacity="0.6" transform="rotate(30 13 20)"></ellipse>
  </svg>
  <strong>{vi ? 'Giáng sinh an lành!' : 'Merry Christmas!'}</strong>{' '}
  {vi ? 'Kim tuyến, dây đèn và đồ ăn tiệc dễ gây nguy hiểm cho chó mèo — cần tư vấn, ' : 'Tinsel, fairy lights and party food can be dangerous for pets — for advice, '}
  {' '}<a href={clinic.phoneHref}>{vi ? 'gọi' : 'call'} {clinic.phone}</a>.
</SeasonBanner>
