---
/* Gentle snowfall: two tiled layers of flakes drifting down at different speeds.
   Each layer is one element moved with `transform`, so it costs two animations. */
interface Props {
  class?: string
  /** Flake colour; on light backgrounds use a pale blue so flakes stay visible. */
  tone?: 'light' | 'dark'
}
const { class: className, tone = 'dark' } = Astro.props
---

<div class:list={['snow', `snow--${tone}`, className]} aria-hidden="true">
  <span class="layer layer-a"></span>
  <span class="layer layer-b"></span>
</div>

<style>
  .snow {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .layer {
    position: absolute;
    inset: -100% 0 0;
    background-repeat: repeat;
  }

  .snow--dark {
    --flake: rgb(255 255 255 / 90%);
    --flake-soft: rgb(255 255 255 / 55%);
  }

  .snow--light {
    --flake: rgb(147 180 222 / 85%);
    --flake-soft: rgb(147 180 222 / 50%);
  }

  .layer-a {
    background-image:
      radial-gradient(3px 3px at 20px 30px, var(--flake) 50%, transparent 51%),
      radial-gradient(2.5px 2.5px at 110px 80px, var(--flake) 50%, transparent 51%),
      radial-gradient(3.5px 3.5px at 170px 150px, var(--flake) 50%, transparent 51%),
      radial-gradient(2px 2px at 60px 190px, var(--flake) 50%, transparent 51%);
    background-size: 220px 220px;
  }

  .layer-b {
    background-image:
      radial-gradient(1.8px 1.8px at 40px 60px, var(--flake-soft) 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 140px 20px, var(--flake-soft) 50%, transparent 51%),
      radial-gradient(2px 2px at 90px 130px, var(--flake-soft) 50%, transparent 51%);
    background-size: 160px 160px;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Moving exactly one tile height makes the loop seamless. */
    :global(html[data-season]) .layer-a {
      animation: fall-a 14s linear infinite;
    }

    :global(html[data-season]) .layer-b {
      animation: fall-b 22s linear infinite;
    }
  }

  @keyframes fall-a {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(22px, 220px, 0);
    }
  }

  @keyframes fall-b {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(-16px, 160px, 0);
    }
  }
</style>
