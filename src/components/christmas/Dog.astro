---
/* A sitting puppy in a Santa hat and scarf: wags its tail, tilts its head, blinks. */
interface Props {
  class?: string
  size?: number
}
const { class: className, size = 100 } = Astro.props
const id = `dog-${crypto.randomUUID().slice(0, 6)}`
---

<svg class:list={['dog', className]} width={size} height={size} viewBox="0 0 100 100" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id={`${id}-fur`} cx="0.35" cy="0.3" r="0.85">
      <stop offset="0" stop-color="#fcd9a5"></stop>
      <stop offset="0.6" stop-color="#e3a35f"></stop>
      <stop offset="1" stop-color="#b8743a"></stop>
    </radialGradient>
    <linearGradient id={`${id}-red`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ef4444"></stop>
      <stop offset="1" stop-color="#991b1b"></stop>
    </linearGradient>
  </defs>
  <g class="tail">
    <path d="M70 86c10-2 16-10 15-20" stroke="#c98545" stroke-width="7" fill="none" stroke-linecap="round"></path>
  </g>
  <path d="M30 98c-5 0-7-4-6-10 2-12 7-24 14-28h24c7 4 12 16 14 28 1 6-1 10-6 10z" fill={`url(#${id}-fur)`}></path>
  <path d="M42 98c0-10 2-24 8-28 6 4 8 18 8 28z" fill="#fff7ed" opacity="0.9"></path>
  <ellipse cx="38" cy="97" rx="7" ry="3.5" fill="#f5c58c"></ellipse>
  <ellipse cx="62" cy="97" rx="7" ry="3.5" fill="#f5c58c"></ellipse>
  <path d="M33 60q17 9 34 0v6q-17 8-34 0z" fill={`url(#${id}-red)`}></path>
  <g class="head">
    <path d="M27 30c-8 0-12 14-8 24 3 6 8 4 9-2zM73 30c8 0 12 14 8 24-3 6-8 4-9-2z" fill="#b8743a"></path>
    <ellipse cx="50" cy="40" rx="23" ry="21" fill={`url(#${id}-fur)`}></ellipse>
    <ellipse cx="50" cy="49" rx="12" ry="9" fill="#fff7ed"></ellipse>
    <g class="eyes">
      <circle cx="41" cy="38" r="3.6" fill="#2a1a12"></circle>
      <circle cx="59" cy="38" r="3.6" fill="#2a1a12"></circle>
      <circle cx="42.3" cy="36.7" r="1.3" fill="#fff"></circle>
      <circle cx="60.3" cy="36.7" r="1.3" fill="#fff"></circle>
    </g>
    <ellipse cx="50" cy="45" rx="4" ry="3" fill="#2a1a12"></ellipse>
    <ellipse cx="48.8" cy="44" rx="1.2" ry="0.8" fill="#fff" opacity="0.7"></ellipse>
    <path d="M45 50q5 4 10 0" stroke="#2a1a12" stroke-width="1.4" fill="none" stroke-linecap="round"></path>
    <path d="M48 52q2 5 4 0" fill="#f472b6"></path>
    <ellipse cx="34" cy="46" rx="3.5" ry="2" fill="#fb7185" opacity="0.5"></ellipse>
    <ellipse cx="66" cy="46" rx="3.5" ry="2" fill="#fb7185" opacity="0.5"></ellipse>
    <g class="hat">
      <path d="M30 26c4-14 20-20 34-12 6 3 10 10 12 16l-6 2c-2-6-5-10-9-11z" fill={`url(#${id}-red)`}></path>
      <rect x="27" y="22" width="44" height="9" rx="4.5" fill="#f8fafc" transform="rotate(-6 49 26)"></rect>
      <circle cx="76" cy="33" r="5" fill="#f8fafc"></circle>
    </g>
  </g>
</svg>

<style>
  .tail,
  .head,
  .eyes {
    transform-box: fill-box;
  }

  .tail {
    transform-origin: 0% 100%;
  }

  .head {
    transform-origin: 50% 90%;
  }

  .eyes {
    transform-origin: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-season]) .tail {
      animation: wag 0.5s ease-in-out infinite alternate;
    }

    :global(html[data-season]) .head {
      animation: tilt 7s ease-in-out infinite;
    }

    :global(html[data-season]) .eyes {
      animation: blink 5s steps(1, end) 0.8s infinite;
    }
  }

  @keyframes wag {
    from {
      transform: rotate(-12deg);
    }

    to {
      transform: rotate(14deg);
    }
  }

  @keyframes tilt {
    0%,
    45%,
    100% {
      transform: rotate(0);
    }

    55%,
    75% {
      transform: rotate(9deg);
    }
  }

  @keyframes blink {
    0%,
    94% {
      transform: none;
    }

    95% {
      transform: scaleY(0.1);
    }

    98% {
      transform: none;
    }
  }
</style>
