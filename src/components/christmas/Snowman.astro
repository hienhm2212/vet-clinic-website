---
/* A friendly snowman: sways, blinks and waves a twig arm; scarf tail flutters. */
interface Props {
  class?: string
  size?: number
}
const { class: className, size = 80 } = Astro.props
const id = `snow-${crypto.randomUUID().slice(0, 6)}`
---

<svg class:list={['snowman', className]} width={size} height={size * 1.25} viewBox="0 0 80 100" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id={`${id}-s`} cx="0.35" cy="0.3" r="0.8">
      <stop offset="0" stop-color="#ffffff"></stop>
      <stop offset="0.65" stop-color="#eef4fb"></stop>
      <stop offset="1" stop-color="#bfd3ea"></stop>
    </radialGradient>
    <linearGradient id={`${id}-sc`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ef4444"></stop>
      <stop offset="1" stop-color="#991b1b"></stop>
    </linearGradient>
  </defs>
  <ellipse cx="40" cy="96" rx="26" ry="3.5" fill="#1e293b" opacity="0.15"></ellipse>
  <g class="body">
    <g class="arm-l">
      <path d="M20 58 6 48M10 51l-4 1M12 52.5 10 47" stroke="#78350f" stroke-width="2.4" stroke-linecap="round" fill="none"></path>
    </g>
    <g class="arm-r">
      <path d="M60 58l14-10M70 51l4 1M68 52.5l2-5.5" stroke="#78350f" stroke-width="2.4" stroke-linecap="round" fill="none"></path>
    </g>
    <circle cx="40" cy="74" r="22" fill={`url(#${id}-s)`}></circle>
    <circle cx="40" cy="69" r="2" fill="#334155"></circle>
    <circle cx="40" cy="79" r="2" fill="#334155"></circle>
    <g class="head">
      <circle cx="40" cy="38" r="17" fill={`url(#${id}-s)`}></circle>
      <path d="M24 30c2-12 30-12 32 0z" fill={`url(#${id}-sc)`}></path>
      <rect x="22" y="27" width="36" height="6" rx="3" fill="#f8fafc"></rect>
      <circle cx="40" cy="17" r="4" fill="#f8fafc"></circle>
      <g class="eyes">
        <circle cx="34" cy="38" r="2.6" fill="#1e293b"></circle>
        <circle cx="46" cy="38" r="2.6" fill="#1e293b"></circle>
        <circle cx="34.9" cy="37.1" r="0.9" fill="#fff"></circle>
        <circle cx="46.9" cy="37.1" r="0.9" fill="#fff"></circle>
      </g>
      <path d="M40 42l11 2.5-11 1.5z" fill="#f97316"></path>
      <ellipse cx="29" cy="44" rx="3" ry="1.7" fill="#fda4af" opacity="0.7"></ellipse>
      <ellipse cx="51" cy="44" rx="3" ry="1.7" fill="#fda4af" opacity="0.7"></ellipse>
      <path d="M35 47.5q5 3 10 0" stroke="#1e293b" stroke-width="1.3" fill="none" stroke-linecap="round"></path>
    </g>
    <path d="M24 53q16 8 32 0v6q-16 7-32 0z" fill={`url(#${id}-sc)`}></path>
    <g class="tail">
      <path d="M48 58l5 18-7 1-3-17z" fill={`url(#${id}-sc)`}></path>
      <path d="M46.5 75l7-1M47 72l6-1" stroke="#fecaca" stroke-width="1" opacity="0.7"></path>
    </g>
    <ellipse cx="32" cy="64" rx="5" ry="8" fill="#fff" opacity="0.6" transform="rotate(-25 32 64)"></ellipse>
  </g>
</svg>

<style>
  .body,
  .arm-r,
  .arm-l,
  .tail,
  .eyes {
    transform-box: fill-box;
  }

  .body {
    transform-origin: 50% 100%;
  }

  .arm-r {
    transform-origin: 0% 100%;
  }

  .arm-l {
    transform-origin: 100% 100%;
  }

  .tail {
    transform-origin: 30% 0%;
  }

  .eyes {
    transform-origin: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-season]) .body {
      animation: sway 6s ease-in-out infinite;
    }

    :global(html[data-season]) .arm-r {
      animation: wave 6s ease-in-out infinite;
    }

    :global(html[data-season]) .tail {
      animation: flutter 2.4s ease-in-out infinite;
    }

    :global(html[data-season]) .eyes {
      animation: blink 4.5s steps(1, end) 1.2s infinite;
    }
  }

  @keyframes sway {
    0%,
    100% {
      transform: rotate(-2deg);
    }

    50% {
      transform: rotate(2deg);
    }
  }

  @keyframes wave {
    0%,
    45%,
    100% {
      transform: rotate(0);
    }

    55% {
      transform: rotate(-22deg);
    }

    62% {
      transform: rotate(-6deg);
    }

    70% {
      transform: rotate(-22deg);
    }

    80% {
      transform: rotate(0);
    }
  }

  @keyframes flutter {
    50% {
      transform: rotate(10deg);
    }
  }

  @keyframes blink {
    0%,
    94% {
      transform: none;
    }

    95% {
      transform: scaleY(0.1);
    }

    98% {
      transform: none;
    }
  }
</style>
