---
import { tr, ui, type Lang } from '../i18n'

interface Props {
  items: { name: string; path: string }[]
  lang: Lang
}
const { items, lang } = Astro.props
---

<nav class="crumbs" aria-label={tr(ui.breadcrumb, lang)}>
  <ol>
    {
      items.map((item, i) => (
        <li>
          {i < items.length - 1 ? <a href={item.path}>{item.name}</a> : <span aria-current="page">{item.name}</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  ol {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--ink-2);
  }

  li + li::before {
    content: '/';
    margin-right: 6px;
    color: #b89a87;
  }

  a {
    color: var(--ink-2);
  }

  a:hover {
    color: var(--brand);
  }
</style>
