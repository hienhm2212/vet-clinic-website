---
import Icon from './Icon.astro'
import { clinic } from '../data/clinic'
import { route, tr, ui, type Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
---

<section class="cta-wrap" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta" data-reveal>
      <div>
        <h2 id="cta-title">
          {lang === 'vi' ? 'Bé nhà bạn cần được khám?' : 'Does your pet need a check-up?'}
        </h2>
        <p>
          {
            lang === 'vi'
              ? `Gọi hoặc nhắn Zalo cho bác sĩ để đặt lịch. Phòng khám mở cửa ${clinic.hours.open} – ${clinic.hours.close} tất cả các ngày.`
              : `Call or message the vet on Zalo to book. We're open ${clinic.hours.open} – ${clinic.hours.close} every day.`
          }
        </p>
      </div>
      <div class="actions">
        <a class="btn btn--light" href={clinic.phoneHref}>
          <Icon name="phone" />
          {tr(ui.call, lang)}: {clinic.phone}
        </a>
        <a class="btn btn--ghost" href={`${route('contact', lang)}#dat-lich`}>
          <Icon name="calendar" />
          {tr(ui.book, lang)}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-wrap {
    padding-block: clamp(48px, 7vw, 88px);
  }

  .cta {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding: clamp(28px, 5vw, 56px);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 100% 0%, rgb(255 255 255 / 16%), transparent 40%),
      linear-gradient(135deg, #c2410c, #9a3412);
    color: #fff;
    overflow: hidden;
  }

  .cta > div:first-child {
    max-width: 560px;
  }

  .cta p {
    margin-top: 10px;
    color: #ffedd5;
    font-size: 1.08rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .btn--light {
    background: #fff;
    color: var(--brand-hover);
  }

  .btn--light:hover {
    background: #fff7ed;
    color: var(--brand-hover);
  }

  .btn--ghost {
    border-color: rgb(255 255 255 / 70%);
    color: #fff;
  }

  .btn--ghost:hover {
    background: rgb(255 255 255 / 14%);
    color: #fff;
  }
</style>
