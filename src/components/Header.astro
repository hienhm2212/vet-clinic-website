---
import Icon from './Icon.astro'
import Logo from './Logo.astro'
import { clinic } from '../data/clinic'
import { route, tr, ui, type Lang, type RouteKey } from '../i18n'

interface Props {
  lang: Lang
  alternates: Record<Lang, string>
}

const { lang, alternates } = Astro.props
const otherLang: Lang = lang === 'vi' ? 'en' : 'vi'
const path = Astro.url.pathname

const links: { key: RouteKey; label: string }[] = [
  { key: 'home', label: tr(ui.nav.home, lang) },
  { key: 'services', label: tr(ui.nav.services, lang) },
  { key: 'about', label: tr(ui.nav.about, lang) },
  { key: 'contact', label: tr(ui.nav.contact, lang) },
]

const isActive = (key: RouteKey) => {
  const href = route(key, lang)
  return key === 'home' ? path === href : path.startsWith(href)
}
---

<header class="site-header" data-header>
  <div class="container bar">
    <a class="brand" href={route('home', lang)} aria-label={tr(clinic.name, lang)}>
      <Logo />
      <svg class="witch-hat seasonal seasonal--halloween" width="40" height="34" viewBox="0 0 40 34" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="hat-cone" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#7c3aed"></stop>
            <stop offset="1" stop-color="#2e1065"></stop>
          </linearGradient>
        </defs>
        <ellipse cx="20" cy="27" rx="19" ry="5" fill="#2e1065"></ellipse>
        <path d="M11 26c2-8 4-15 8-19 2-2 6-5 11-4-4 1-6 4-6 7 1 5 3 11 5 16z" fill="url(#hat-cone)"></path>
        <path d="M11.6 22.5h17.6l1 3.6H10.8z" fill="#f97316"></path>
        <rect x="17.6" y="22" width="5" height="4.6" rx="1" fill="none" stroke="#fde047" stroke-width="1.4"></rect>
        <ellipse cx="16" cy="13" rx="1.5" ry="4" fill="#fff" opacity="0.18" transform="rotate(20 16 13)"></ellipse>
        <circle cx="30" cy="3.2" r="1.6" fill="#fde047"></circle>
      </svg>
      <svg class="santa-hat seasonal seasonal--christmas" width="42" height="34" viewBox="0 0 42 34" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="santa-red" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#f87171"></stop>
            <stop offset="0.5" stop-color="#dc2626"></stop>
            <stop offset="1" stop-color="#991b1b"></stop>
          </linearGradient>
        </defs>
        <path d="M6 25C8 12 18 4 28 6c6 1 9 7 10 13l-5 1c-1-4-3-7-6-7-6 0-10 6-11 12z" fill="url(#santa-red)"></path>
        <ellipse cx="14" cy="13" rx="2" ry="5" fill="#fff" opacity="0.25" transform="rotate(40 14 13)"></ellipse>
        <rect x="3" y="22" width="26" height="8" rx="4" fill="#f8fafc"></rect>
        <path d="M5 26h22" stroke="#cbd5e1" stroke-width="1" stroke-linecap="round" opacity="0.7"></path>
        <g class="pompom"><circle cx="36" cy="21" r="4.5" fill="#f8fafc"></circle><circle cx="34.8" cy="19.8" r="1.4" fill="#fff"></circle></g>
      </svg>
      <span class="brand-text">
        <span class="brand-name">{tr(clinic.shortName, lang)}</span>
        <span class="brand-tag">{lang === 'vi' ? 'Phòng khám thú y · Bình Mỹ' : 'Veterinary clinic · Binh My'}</span>
      </span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-toggle
    >
      <Icon name="menu" class="icon-open" />
      <Icon name="x" class="icon-close" />
      <span class="sr-only">{tr(ui.menu, lang)}</span>
    </button>

    <nav id="site-nav" class="nav" aria-label={lang === 'vi' ? 'Điều hướng chính' : 'Main navigation'} data-nav>
      <ul class="nav-links">
        {
          links.map(link => (
            <li>
              <a href={route(link.key, lang)} aria-current={isActive(link.key) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="nav-actions">
        <a class="lang-link" href={alternates[otherLang]} hreflang={otherLang} lang={otherLang}>
          <Icon name="globe" size={18} />
          <span>{otherLang.toUpperCase()}</span>
          <span class="sr-only">– {tr(ui.switchLang, lang)}</span>
        </a>
        <a class="btn btn--primary nav-call" href={clinic.phoneHref}>
          <Icon name="phone" />
          <span>{clinic.phone}</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 250 244 / 92%);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }

  .site-header[data-scrolled] {
    border-color: var(--line);
    box-shadow: 0 4px 24px rgb(74 40 20 / 8%);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: var(--header-h);
  }

  .brand {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
  }

  .brand:hover {
    color: var(--ink);
  }

  .witch-hat {
    position: absolute;
    top: -17px;
    left: -9px;
    rotate: -16deg;
    transform-origin: 50% 80%;
    transition: rotate 0.3s ease;
    filter: drop-shadow(0 2px 2px rgb(46 16 101 / 25%));
  }

  .santa-hat {
    position: absolute;
    top: -15px;
    left: -10px;
    rotate: -14deg;
    transform-origin: 30% 90%;
    transition: rotate 0.3s ease;
    filter: drop-shadow(0 2px 2px rgb(127 29 29 / 25%));
  }

  .santa-hat .pompom {
    transform-box: fill-box;
    transform-origin: 50% 0%;
  }

  .brand:hover .santa-hat {
    rotate: -24deg;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-season]) .santa-hat .pompom {
      animation: pompom 3s ease-in-out infinite;
    }
  }

  @keyframes pompom {
    0%,
    70%,
    100% {
      transform: none;
    }

    78% {
      transform: translate(1px, 3px) scale(1.08, 0.92);
    }

    86% {
      transform: translate(-1px, -1px);
    }
  }

  .brand:hover .witch-hat {
    rotate: -28deg;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-season]) .witch-hat {
      animation: hat-wobble 6s ease-in-out infinite;
    }
  }

  @keyframes hat-wobble {
    0%,
    80%,
    100% {
      transform: none;
    }

    85% {
      transform: rotate(-8deg) translateY(-2px);
    }

    90% {
      transform: rotate(6deg);
    }

    95% {
      transform: rotate(-3deg);
    }
  }

  .brand-text {
    display: grid;
    line-height: 1.1;
  }

  .brand-name {
    font-family: var(--font-head);
    font-size: 1.3rem;
    font-weight: 700;
  }

  .brand-tag {
    font-size: 0.75rem;
    color: var(--ink-2);
    font-weight: 700;
  }

  .nav-links {
    list-style: none;
    padding: 0;
    display: flex;
    gap: 4px;
  }

  .nav-links a {
    display: block;
    padding: 10px 14px;
    border-radius: 999px;
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .nav-links a:hover {
    background: var(--brand-soft);
    color: var(--brand-hover);
  }

  .nav-links a[aria-current='page'] {
    color: var(--brand);
    background: var(--brand-soft);
  }

  .nav,
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .lang-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 8px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--ink);
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    background: var(--surface);
  }

  .lang-link:hover {
    border-color: var(--brand);
    color: var(--brand);
  }

  .nav-call {
    min-height: 44px;
    padding: 10px 18px;
  }

  .menu-toggle {
    display: none;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    cursor: pointer;
  }

  .menu-toggle :global(.icon-close),
  .menu-toggle[aria-expanded='true'] :global(.icon-open) {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] :global(.icon-close) {
    display: block;
  }

  /* Mobile: a slide-down menu when JS is available, a simple wrapped nav otherwise. */
  @media (max-width: 960px) {
    .bar {
      flex-wrap: wrap;
    }

    .nav {
      flex-wrap: wrap;
      padding-bottom: 12px;
    }

    :global(.js) .menu-toggle {
      display: inline-flex;
    }

    :global(.js) .bar {
      flex-wrap: nowrap;
    }

    :global(.js) .nav {
      position: fixed;
      inset: var(--header-h) 0 auto;
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: stretch;
      gap: 16px;
      padding: 20px var(--gutter) 28px;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 24px 40px rgb(74 40 20 / 14%);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition:
        opacity 0.2s,
        transform 0.2s,
        visibility 0s 0.2s;
    }

    :global(.js) .nav[data-open] {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition:
        opacity 0.2s,
        transform 0.2s;
    }

    :global(.js) .nav-links {
      flex-direction: column;
    }

    :global(.js) .nav-links a {
      padding: 14px 16px;
      font-size: 1.1rem;
      border-radius: 14px;
    }

    :global(.js) .nav-actions {
      justify-content: space-between;
    }

    :global(.js) .nav-call {
      flex: 1;
    }
  }

  @media (max-width: 380px) {
    .brand-tag {
      display: none;
    }
  }
</style>
